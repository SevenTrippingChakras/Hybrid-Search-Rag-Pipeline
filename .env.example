# Copy this file to .env and fill in the values you need.
#   cp .env.example .env

# OpenAI API key — used for chunk embeddings (text-embedding-3-small). Always required.
OPENAI_API_KEY=

# Which vector-store backend the Index uses: chroma | pinecone | milvus.
# Default is chroma (local, zero setup); only fill the section below for the one you pick.
VECTOR_BACKEND=chroma

# --- pinecone (only if VECTOR_BACKEND=pinecone) ---
# Index must be dimension 1536, metric cosine (matches text-embedding-3-small).
PINECONE_API_KEY=
PINECONE_INDEX=hybrid-rag

# --- milvus / zilliz cloud (only if VECTOR_BACKEND=milvus) ---
# URI is the cluster public endpoint; TOKEN is the API key (empty for local Milvus).
MILVUS_URI=
MILVUS_TOKEN=
