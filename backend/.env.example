# Copy this file to .env and fill in the values you need.

OPENAI_API_KEY=


VECTOR_BACKEND=opensearch


OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_INDEX=chunks


# Object storage for uploaded documents (S3-compatible: Supabase / R2 / AWS S3).
# See planning/cloudflare-r2-setup.md for how to obtain these.
STORAGE_BACKEND=s3
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
