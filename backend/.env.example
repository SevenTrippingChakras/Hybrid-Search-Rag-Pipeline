# Copy this file to .env and fill in the values you need.

OPENAI_API_KEY=


VECTOR_BACKEND=opensearch


OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_INDEX=chunks


# Object storage for uploaded documents (S3-compatible: Supabase / R2 / AWS S3).
# See planning/cloudflare-r2-setup.md for how to obtain these.
STORAGE_BACKEND=s3
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=


# Document metadata store (MongoDB Atlas, hosted). Get the connection string from
# Atlas -> Connect -> Drivers. The database name is set separately by MONGO_DB, so
# the URI can end at "/?..." without a db path.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=hybrid_rag
